# Public site
NEXT_PUBLIC_SITE_URL=https://www.nebuloidtechstudio.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Analytics
# Prefer GTM when you manage tags in Tag Manager (set NEXT_PUBLIC_GTM_ID=GTM-XXXX).
# Otherwise leave GTM empty and use direct gtag.js for GA4 + Google Ads.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-BYJ6D14KLM
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18308378295
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=1583262146501649
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Contact form
GOOGLE_SHEETS_WEBHOOK_URL=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# CMS (Neon Postgres + Vercel Blob)
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Must match the Blob store mode (cannot change after store creation).
# Use "private" for private stores, "public" for public stores.
BLOB_ACCESS=private
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Floating chatbot (Gemini) — answers using site content only
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Seed admin (`npm run cms:seed`)
ADMIN_EMAIL=admin@nebuloidtechstudio.com
ADMIN_PASSWORD=ChangeMeNow!123
ADMIN_NAME=Nebuloid Admin
