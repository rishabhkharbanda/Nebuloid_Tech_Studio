# Public site
NEXT_PUBLIC_SITE_URL=https://www.nebuloidtechstudio.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Analytics (optional — prefer configuring GA4 inside GTM to avoid double counting)
NEXT_PUBLIC_GTM_ID=GTM-T9NF3BKQ
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Contact form
GOOGLE_SHEETS_WEBHOOK_URL=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# CMS (Neon Postgres + Vercel Blob)
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Must match the Blob store mode (cannot change after store creation).
# Use "private" for private stores, "public" for public stores.
BLOB_ACCESS=private
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Seed admin (`npm run cms:seed`)
ADMIN_EMAIL=admin@nebuloidtechstudio.com
ADMIN_PASSWORD=ChangeMeNow!123
ADMIN_NAME=Nebuloid Admin
